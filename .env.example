# --- cluster ---
# Which cluster the API, indexer and keeper default to when a request does not name one. Meteora's
# programs share the same ids on devnet and mainnet, but the vault program is devnet-only.
CLUSTER=devnet

# --- indexer / api / keeper ---
RPC_URL=https://api.devnet.solana.com
# Comma-separated RPC endpoints, tried in order with retry + failover. Set this to a private RPC
# (Helius, QuickNode, Triton) so a demo never sees a 429 from the shared public endpoint.
RPC_URLS=
METEORA_DATA_API=https://damm-v2.datapi.meteora.ag
DATABASE_URL=
PORT=8787

# --- keeper ---
KEYPAIR=
# Minimum claimable fees (both mints, in token base units) before a vault is cranked. 0 cranks each tick.
CRANK_THRESHOLD_BASE_UNITS=0
CRANK_INTERVAL_MS=120000

# --- vault registry ---
# Which cluster the app reads the vault registry from (the chain the `perpetua_vault` program is
# deployed on). Devnet today; change it when the program ships to another cluster.
VAULT_CLUSTER=devnet

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8787
# The RPC the browser signs against. Fee history is indexed on mainnet only, so pool links always open
# on mainnet; this is the cluster the app's own vaults, mints and transactions live on.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Used only when a transaction is built for mainnet (token launches).
NEXT_PUBLIC_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com

# Comma-separated browser origins allowed to call the API. Unset in development allows the local
# web app; unset in production is same-origin only.
CORS_ORIGINS=

# --- program identity ---
# Informational: `declare_id!` in programs/perpetua_vault/src/lib.rs is the single source of truth,
# and scripts/program-id.mjs checks Anchor.toml against it.
PROGRAM_ID=G7ixan3xxy2SRR84Qnv7pUAh1wSinYdhzKwJyhFfqWH2
