# --- indexer / api / keeper ---
RPC_URL=https://api.devnet.solana.com
# Comma-separated RPC endpoints, tried in order with retry + failover. Set this to a private RPC
# (Helius, QuickNode, Triton) so a demo never sees a 429 from the shared public endpoint.
RPC_URLS=
METEORA_DATA_API=https://dlmm.datapi.meteora.ag
DATABASE_URL=
PORT=8787

# --- keeper ---
KEYPAIR=
CRANK_THRESHOLD_USD=0
CRANK_INTERVAL_MS=120000

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8787

# Comma-separated browser origins allowed to call the API. Unset in development allows the local
# web app; unset in production is same-origin only.
CORS_ORIGINS=

# --- program deploy ---
PROGRAM_ID=G7ixan3xxy2SRR84Qnv7pUAh1wSinYdhzKwJyhFfqWH2
