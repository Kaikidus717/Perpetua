{
  "name": "@perpetua/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@hono/node-server": "2.1.3",
    "@perpetua/mcp": "workspace:*",
    "@perpetua/sdk": "workspace:*",
    "@perpetua/shared": "workspace:*",
    "@perpetua/valuation": "workspace:*",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.99.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "drizzle-kit": "0.31.11",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
