{
  "name": "perpetua",
  "private": true,
  "version": "0.1.0",
  "description": "Perpetua - the fee-rights exchange for Meteora",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:fn": "node netlify/api/build.mjs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "turbo run clean",
    "program:check": "node scripts/program-id.mjs check",
    "program:sync": "node scripts/program-id.mjs sync",
    "program:keypair": "node scripts/program-id.mjs install-keypair",
    "ops:faucet": "node scripts/faucet.mjs",
    "mcp": "pnpm --filter @perpetua/mcp start",
    "idl": "node scripts/gen-idl.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "esbuild": "0.23.1",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
