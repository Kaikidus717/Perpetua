{
  "name": "@perpetua/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "default": "./dist/ports.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./sale": {
      "types": "./dist/sale/ladder.d.ts",
      "default": "./dist/sale/ladder.js"
    },
    "./dbc": {
      "types": "./dist/dbc/preset.d.ts",
      "default": "./dist/dbc/preset.js"
    },
    "./math": {
      "types": "./dist/math/feePerShare.d.ts",
      "default": "./dist/math/feePerShare.js"
    },
    "./positions": {
      "types": "./dist/positions/eligibility.d.ts",
      "default": "./dist/positions/eligibility.js"
    },
    "./bins": {
      "types": "./dist/sale/bins.d.ts",
      "default": "./dist/sale/bins.js"
    },
    "./bids": {
      "types": "./dist/sale/bids.d.ts",
      "default": "./dist/sale/bids.js"
    },
    "./adapters/damm-v2": {
      "types": "./dist/adapters/dammV2.d.ts",
      "default": "./dist/adapters/dammV2.js"
    },
    "./adapters/dlmm": {
      "types": "./dist/adapters/dlmm.d.ts",
      "default": "./dist/adapters/dlmm.js"
    },
    "./adapters/dbc": {
      "types": "./dist/adapters/dbc.d.ts",
      "default": "./dist/adapters/dbc.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "ops:create-vault": "tsx scripts/create-vault.ts",
    "ops:devnet-e2e": "tsx scripts/devnet-e2e.ts",
    "ops:swap": "tsx scripts/swap-devnet.ts",
    "ops:probe": "tsx scripts/devnet-probe.ts",
    "ops:rpc": "tsx scripts/rpc-health.ts",
    "ops:verify-offsets": "tsx scripts/verify-position-offsets.ts",
    "ops:extract-idls": "node scripts/extract-meteora-idls.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@meteora-ag/dlmm": "1.9.14",
    "@perpetua/shared": "workspace:*",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/node": "22.10.2",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
