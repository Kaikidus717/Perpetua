    "clean": "rimraf dist"
  },
  "dependencies": {
    "@perpetua/shared": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
